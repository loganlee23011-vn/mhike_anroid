        <item name="colorSurfaceVariant">@color/mhike_background</item>
        <item name="colorOnSurfaceVariant">@color/mhike_text_secondary</item>
        <item name="colorSurfaceContainer">@color/mhike_surface</item>
        <item name="colorSurfaceContainerLow">@color/mhike_background</item>
        <item name="colorSurfaceContainerLowest">@color/mhike_background</item>
        <item name="colorSurfaceContainerHigh">@color/mhike_surface</item>
        <item name="colorSurfaceContainerHighest">@color/mhike_surface</item>
        <item name="colorOutline">@color/mhike_outline</item>
        <item name="colorOutlineVariant">@color/mhike_outline</item>
        <item name="android:colorBackground">@color/mhike_background</item>
        <item name="colorOnBackground">@color/mhike_text_primary</item>
        <item name="android:windowBackground">@color/mhike_background</item>
    </style>

    <style name="Theme.MHikeAndroid" parent="Base.Theme.MHikeAndroid" />

    <style name="ShapeAppearance.MHike.Thumbnail" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>
</resources>